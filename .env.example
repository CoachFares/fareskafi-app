# انسخ هذا الملف باسم .env.local وعبّي القيم — كل سطر أشرحه هنا:

# من Supabase → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# اسم منتجك بالضبط في Gumroad (يظهر في رابط صفحة المنتج)
GUMROAD_PRODUCT_PERMALINK=

# من Resend → API Keys (لإرسال بريد الوصول)
RESEND_API_KEY=

# دومينك بعد ربطه (بدون https://)
APP_DOMAIN=app.fareskafi.com

# مفتاح Anthropic API — لخيار "التحليل الأعمق بالذكاء الاصطناعي"
# نحصل عليه سوا من console.anthropic.com وقت ما نوصل هذي الخطوة
ANTHROPIC_API_KEY=
